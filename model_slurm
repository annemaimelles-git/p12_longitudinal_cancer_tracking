#!/bin/bash
#SBATCH --job-name=model-test
#SBATCH --partition=gpu
#SBATCH --gres=gpu:a100-40g:1       # GPU type must be named; a100-80g also works
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=logs/model_%j.out  # %j = job ID

source ~/venvs/lct/bin/activate
cd ~/work/data

python -c "import torch; print(torch.__version__, torch.cuda.is_available(), torch.cuda.get_device_name(0))"
python model.py info
python model.py test 1
